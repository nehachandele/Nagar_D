# ==============================================================================
# NAGAR DRISHTI ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Mode & Core
PROJECT_NAME="Nagar Drishti - Civic Issue Management Platform"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=nagar_drishti_super_secret_jwt_key_change_in_production_2026!
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for zero-config dev, or PostgreSQL + PostGIS)
DATABASE_URL=sqlite:///./nagar_drishti.db

# PostGIS / PostgreSQL Production DB Settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nagar_drishti

# Storage & Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15

# AI Services
YOLO_MODEL_PATH=../ai/models/yolov8_civic.pt
EMBEDDING_MODEL_NAME=resnet50
USE_MOCK_AI_IN_DEV=True
DUPLICATE_DISTANCE_THRESHOLD_METERS=150.0
DUPLICATE_EMBEDDING_SIMILARITY_THRESHOLD=0.85
DUPLICATE_OVERALL_SCORE_THRESHOLD=0.80

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
